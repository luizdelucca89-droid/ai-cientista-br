# Copie para .env e preencha as chaves. O .env está no .gitignore.
#
# Use EXATAMENTE estes nomes: o catálogo (config.modelos.json) os lê literalmente.
# Um nome diferente deixa o provider indisponível em silêncio e a categoria
# passa a usar o coringa. Confira com: python main.py --doctor --no-network
#
# GEMINI_API_KEY é a única obrigatória: ela liga o coringa, que atende qualquer
# tarefa quando a rota específica não tem chave ou estourou a cota.
GEMINI_API_KEY=

# Opcionais: habilitam as rotas específicas do catálogo (config.modelos.json).
# NVIDIA_API_KEY=      # 7 modelos, endpoint integrate.api.nvidia.com (NIM)
# OPENROUTER_API_KEY=  # 5 modelos
# MISTRAL_API_KEY=     # 5 modelos (codestral, para código)

